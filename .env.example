# Paste values only into a local .env file. Do not share this file or commit it.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_GUILD_ID=replace-with-your-server-id

# Optional notification settings. The channel IDs can be copied in Discord's
# Developer Mode. DAILY_REPORT_HOUR uses the machine/server's local time.
# NOTIFICATION_CHANNEL_ID=
# DAILY_REPORT_CHANNEL_ID=
# DAILY_REPORT_HOUR=9
# MEETING_REMINDER_MINUTES=15
# DAILY_TIME_ZONE=Asia/Ho_Chi_Minh

# Translation uses DeepL. Create a free API key at https://www.deepl.com/pro-api
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Optional. Comma-separated list of Vietnamese profanity keywords for the
# AutoMod rule. Use * as wildcard (e.g. *đm*). Leave unset to use the built-in
# default list in setup-server.js.
# VIETNAMESE_PROFANITY_KEYWORDS=*đm*,*vcl*,*lồn*,*cặc*
